# earnings-summarizer environment variables
# Copy this to .env and fill in your values

# Required: Your Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override the default model
# EARNINGS_MODEL=claude-opus-4-7

# Optional: Customize thinking budget (tokens)
# EARNINGS_THINKING_BUDGET=8000
