# earnings-summarizer — environment variables
# Copy this to .env and fill in your values (for local use)
# For GitHub Actions, add these as repository Secrets instead

# ── Anthropic (required) ──────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail (required for email delivery) ──────────────────────────
# Your Gmail address
GMAIL_USER=you@gmail.com

# 16-character App Password from Google Account → Security → App Passwords
# NOT your regular Gmail password. No spaces.
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# Where to send the summaries (can be same as GMAIL_USER)
TO_EMAIL=you@gmail.com

# ── Optional ──────────────────────────────────────────────────────
# Custom cron schedule for daemon mode (default: weekdays 9 AM local)
# CRON_SCHEDULE=0 9 * * 1-5
